# Convert little-endian SPIR-V words to a C++ initializer without Python/host tools.
file(READ "${SOURCE}" bytes HEX)
string(LENGTH "${bytes}" size)
math(EXPR remainder "${size} % 8")
if(size LESS 8 OR NOT remainder EQUAL 0)
  message(FATAL_ERROR "SPIR-V input must contain complete 32-bit words")
endif()
string(SUBSTRING "${bytes}" 0 8 magic)
if(NOT magic STREQUAL "03022307")
  message(FATAL_ERROR "Invalid little-endian SPIR-V header")
endif()
string(REGEX MATCHALL "........" words "${bytes}")
set(initializer "")
foreach(word IN LISTS words)
  string(SUBSTRING "${word}" 0 2 b0)
  string(SUBSTRING "${word}" 2 2 b1)
  string(SUBSTRING "${word}" 4 2 b2)
  string(SUBSTRING "${word}" 6 2 b3)
  string(APPEND initializer "0x${b3}${b2}${b1}${b0},\n")
endforeach()
file(WRITE "${OUTPUT}" "${initializer}")
